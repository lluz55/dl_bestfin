# BestFin - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to the repository — it contains secrets.
#
# O script de release (scripts/release.sh) carrega automaticamente
# as variáveis deste arquivo se ele existir.

# Chave pública Nostr
# Aceita formato hex (64 chars), npub (bech32) ou caminho de arquivo.
# Exemplos:
#   BESTFIN_DEV_NOSTR_PUBKEY=df0e05800998ec8159e052491107294b2f85d6594ea9d45ebc9765c98a2d8c70
#   BESTFIN_DEV_NOSTR_PUBKEY=npub1k6ld6y8s8z6r6z6z6r6z6r6z6r6z6r6z6r6z6r6z6r6z6r6z6r6
#   BESTFIN_DEV_NOSTR_PUBKEY=/home/user/.nostr/bestfin-pubkey.hex
# Deve ser a mesma do kDeveloperNostrPubkey em lib/core/constants/app_info.dart.
BESTFIN_DEV_NOSTR_PUBKEY=npub1k6ld6y8s8z6r6z6z6r6z6r6z6r6z6r6z6r6z6r6z6r6z6r6z6r6

# Chave privada Nostr
# Aceita tanto formato hex (64 chars) quanto nsec (bech32), bem como
# o caminho de um arquivo contendo a chave (em qualquer formato).
# Usar caminho de arquivo é mais seguro (evita vazar no history do shell
# ou no ps aux).
# Exemplos:
#   BESTFIN_DEV_NOSTR_PRIVKEY=deadbeef...deadbeef
#   BESTFIN_DEV_NOSTR_PRIVKEY=nsec1...
#   BESTFIN_DEV_NOSTR_PRIVKEY=/home/user/.nostr/bestfin-privkey.hex
BESTFIN_DEV_NOSTR_PRIVKEY=/home/user/.nostr/bestfin-privkey.hex
