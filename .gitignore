# Environment (secrets — never commit)
.env

# Android signing keystore (secrets — never commit; ver .github/workflows/release.yml)
android/key.properties
*.jks
!*.enc.jks

# Nix
result

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains maintainer specific settings and tasks.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
*.g.dart
*.freezed.dart

# Web related
lib/generated_plugin_registrant.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will automatically add this to its gitignore in its next version
# which will result in a warning if it is already tracked.
/.idea/workspace.xml

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages

# Local SQLite databases (contain user credentials / encrypted keys, never commit)
backend/data/*.sqlite
backend/data/*.sqlite-shm
backend/data/*.sqlite-wal
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal

# Release artifacts
bestfin-*.tar.gz

# Local agent/tooling state
.mcp.json
.mimocode/
memory/
